# KitchenOwl Environment Configuration
# Copy this file to .env and configure the values

# JWT Secret Key (REQUIRED)
# Generate a secure random key using: openssl rand -hex 64
# This key is used for signing JWT tokens and should be kept secret
JWT_SECRET_KEY=your_secret_key_here

# HTTP Port (OPTIONAL)
# The port on the host machine where KitchenOwl will be accessible
# Default: 8080
HTTP_PORT=8080

# Frontend URL (OPTIONAL)
# The public URL where KitchenOwl will be accessed
# Used for generating links and CORS configuration
FRONT_URL=https://kitchenowl.example.com
